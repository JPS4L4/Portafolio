/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Content-Security-Policy: default-src 'self'; script-src 'self' 'sha256-jRzzRoY0sxKb3w35zqJ+BvzvrPQ97vOjTEiEZyTlQVw=' https://cdn.jsdelivr.net; style-src 'self' 'sha256-+1uckwsxueHx1eIzX3iSHABm1hVL+KmapHSCx0n9ug8=' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'

/
  Cache-Control: public, max-age=0, must-revalidate

/*.html
  Cache-Control: public, max-age=0, must-revalidate

/static/css/*
  Cache-Control: public, max-age=0, must-revalidate

/static/js/*
  Cache-Control: public, max-age=0, must-revalidate

/static/data/*
  Cache-Control: public, max-age=0, must-revalidate

/static/images/*
  Cache-Control: public, max-age=2592000
